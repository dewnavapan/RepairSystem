@model RepairSystem.Web.Models.ViewModels.UpdateJobVM

@{
    ViewData["Title"] = "อัปเดตสถานะงานซ่อม";
}

<div class="container mt-4">
    <h2><i class="bi bi-journal-check"></i> @ViewData["Title"]</h2>
    <hr />

    <div class="row">
        <!-- คอลัมน์ซ้าย: ข้อมูลงานดั้งเดิม (อ่านได้อย่างเดียว) -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light fw-bold">ข้อมูลการแจ้งซ่อม</div>
                <div class="card-body">
                    <h5 class="card-title text-primary">@Model.Title</h5>
                    <p class="card-text"><strong>รายละเอียด:</strong> @Model.Description</p>
                    <p class="card-text"><strong>สถานที่:</strong> @Model.Location</p>
                    <p class="card-text"><strong>หมวดหมู่:</strong> @Model.CategoryName</p>
                    <p class="card-text">
                        <strong>สถานะปัจจุบัน:</strong> 
                        <span class="badge bg-info text-dark">@Model.CurrentStatus</span>
                    </p>
                </div>
            </div>
        </div>

        <!-- คอลัมน์ขวา: ฟอร์มอัปเดตสถานะและบันทึกการทำงาน -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white fw-bold">บันทึกการทำงาน</div>
                <div class="card-body">
                    <form asp-action="UpdateJob" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="form-group mb-3">
                            <label asp-for="NewStatus" class="form-label fw-bold"></label>
                            <select asp-for="NewStatus" class="form-select" asp-items="Model.StatusOptions">
                                <option value="">-- เลือกสถานะใหม่ --</option>
                            </select>
                            <span asp-validation-for="NewStatus" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Comment" class="form-label fw-bold"></label>
                            <textarea asp-for="Comment" class="form-control" rows="3" placeholder="ระบุวิธีแก้ไข อะไหล่ที่ใช้ หรือหมายเหตุอื่นๆ"></textarea>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">กลับไปหน้า Dashboard</a>
                            <button type="submit" class="btn btn-success">บันทึกข้อมูล</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}