@{
    ViewData["Title"] = "แผงควบคุมช่างซ่อม";
    var availableJobs = ViewBag.AvailableJobs as List<RepairSystem.Web.Models.Entities.RepairRequest>;
    var myActiveJobs = ViewBag.MyActiveJobs as List<RepairSystem.Web.Models.Entities.RepairRequest>;
}

<div class="container mt-4">
    <h2><i class="bi bi-tools"></i> @ViewData["Title"]</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- คอลัมน์ซ้าย: งานกองกลาง -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white fw-bold">
                    งานที่รอรับ (Available Jobs) <span class="badge bg-light text-dark">@(availableJobs?.Count ?? 0)</span>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (availableJobs == null || !availableJobs.Any())
                        {
                            <li class="list-group-item text-center text-muted py-4">ไม่มีงานใหม่ในขณะนี้</li>
                        }
                        else
                        {
                            foreach (var job in availableJobs)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1 fw-bold">@job.Title</h6>
                                            <small class="text-muted"><i class="bi bi-geo-alt"></i> @job.Location</small><br />
                                            <small class="text-muted">หมวดหมู่: @job.Category?.Name</small>
                                        </div>
                                        <form asp-action="ClaimJob" method="post">
                                            <input type="hidden" name="id" value="@job.Id" />
                                            <button type="submit" class="btn btn-sm btn-success">กดรับงาน</button>
                                        </form>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- คอลัมน์ขวา: งานของฉัน -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white fw-bold">
                    งานที่ฉันรับผิดชอบ (My Active Jobs) <span class="badge bg-light text-dark">@(myActiveJobs?.Count ?? 0)</span>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (myActiveJobs == null || !myActiveJobs.Any())
                        {
                            <li class="list-group-item text-center text-muted py-4">คุณยังไม่มีงานที่กำลังดำเนินการ</li>
                        }
                        else
                        {
                            foreach (var job in myActiveJobs)
                            {
                                <li class="list-group-item bg-light">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1 fw-bold text-success">@job.Title</h6>
                                            <small class="text-muted"><i class="bi bi-geo-alt"></i> @job.Location</small><br />
                                            <span class="badge @(job.Status == "Accepted" ? "bg-info text-dark" : "bg-primary")">@job.Status</span>
                                        </div>
                                       <a asp-action="UpdateJob" asp-route-id="@job.Id" class="btn btn-sm btn-outline-success">อัปเดตงาน</a>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>