@model RepairSystem.Web.Models.ViewModels.CreateRepairRequestVM

@{
    ViewData["Title"] = "แจ้งซ่อมใหม่";
}

<div class="container mt-4">
    <h2><i class="bi bi-tools"></i> @ViewData["Title"]</h2>
    <hr />

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-body">
                    <!-- สังเกต enctype สำคัญมากสำหรับการแนบไฟล์ -->
                    <form asp-action="Create" enctype="multipart/form-data" method="post">
                        
                        <div class="form-group mb-3">
                            <label asp-for="Title" class="form-label fw-bold"></label>
                            <input asp-for="Title" class="form-control" placeholder="เช่น แอร์ไม่เย็น, น้ำรั่ว" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="CategoryId" class="form-label fw-bold"></label>
                                <select asp-for="CategoryId" class="form-select" asp-items="Model.Categories">
                                    <option value="">-- เลือกประเภทงานซ่อม --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Location" class="form-label fw-bold"></label>
                                <input asp-for="Location" class="form-control" placeholder="ระบุสถานที่ให้ชัดเจน" />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="อธิบายรายละเอียดปัญหาที่พบ"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Attachments" class="form-label fw-bold"></label>
                            <input asp-for="Attachments" type="file" class="form-control" multiple accept="image/jpeg, image/png" />
                            <small class="text-muted">รองรับไฟล์ .jpg, .png สูงสุด 3 รูป</small>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">ยกเลิก</a>
                            <button type="submit" class="btn btn-primary">ส่งเรื่องแจ้งซ่อม</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ส่วนนี้เรียกใช้ Script ตรวจสอบข้อมูลก่อนกด Submit -->
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}