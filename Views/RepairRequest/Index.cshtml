@model IEnumerable<RepairSystem.Web.Models.Entities.RepairRequest>

@{
    ViewData["Title"] = "ประวัติการแจ้งซ่อม";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-card-list"></i> @ViewData["Title"]</h2>
        <a asp-action="Create" class="btn btn-primary">+ แจ้งซ่อมใหม่</a>
    </div>
    <hr />

    <div class="card shadow-sm">
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>วันที่แจ้ง</th>
                        <th>หัวข้อ</th>
                        <th>สถานที่</th>
                        <th>ประเภท</th>
                        <th>สถานะ</th>
                        <th>จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">ยังไม่มีประวัติการแจ้งซ่อม</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CreatedOn.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><strong>@item.Title</strong></td>
                                <td>@item.Location</td>
                                <td>@item.Category?.Name</td>
                                <td>
                                    @if (item.Status == "Submitted") { <span class="badge bg-warning text-dark">รอดำเนินการ</span> }
                                    else if (item.Status == "Accepted") { <span class="badge bg-info text-dark">รับงานแล้ว</span> }
                                    else if (item.Status == "InProgress") { <span class="badge bg-primary">กำลังซ่อม</span> }
                                    else if (item.Status == "Completed") { <span class="badge bg-success">ซ่อมเสร็จสิ้น</span> }
                                    else { <span class="badge bg-secondary">@item.Status</span> }
                                </td>
                                <td>
                                    <a href="#" class="btn btn-sm btn-outline-secondary">ดูรายละเอียด</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>